{
  "name": "react-native-fs2",
  "version": "4.0.0",
  "description": "Native filesystem access for react-native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "cd example && npm i",
    "example:android": "cd example && npm run android",
    "example:ios": "cd example && npm run ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "verify:device": "node scripts/verify-device.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sourcetoad/react-native-fs2.git"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "fs",
    "filesystem",
    "download",
    "nitrogen"
  ],
  "contributors": [
    "Johannes Lumpe <johannes@lum.pe> (https://github.com/johanneslumpe)",
    "Hagen Hübel <hhuebel@itinance.com> (https://github.com/itinance)",
    "Connor Tumbleson <connor@sourcetoad.com> (https://github.com/iBotPeaches)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sourcetoad/react-native-fs2/issues"
  },
  "homepage": "https://github.com/sourcetoad/react-native-fs2#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.37.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-safe-area-context": "5.9.1",
    "turbo": "^2.5.6",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.82.0",
    "react-native-nitro-modules": "^0.37.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "kotlin-swift",
    "type": "nitro-module",
    "version": "0.50.2"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "overrides": {
    "react-native-monorepo-config": "0.2.2"
  },
  "codegenConfig": {
    "name": "RNFS2Spec",
    "type": "modules",
    "jsSrcsDir": "src/nitro",
    "android": {
      "javaPackageName": "com.margelo.nitro.fs2"
    }
  }
}
